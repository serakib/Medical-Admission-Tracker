{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "medical-admission-tracker",
  "main": "./workers.js",
  "compatibility_date": "2026-10-06",
  "workers_dev": true,
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": [
      "/chat",
      "/chat/*",
      "/health"
    ]
  },
  "observability": {
    "enabled": true
  }
}
